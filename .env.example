# ==========================================
# てらログ 環境変数テンプレート
# .env.local にコピーして値を設定してください
# ==========================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# JWT（将来のカスタム認証用）
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRY=30m
JWT_REFRESH_EXPIRY=7d

# 通知
FCM_SERVER_KEY=your-firebase-cloud-messaging-key
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token

# メール送信
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@your-domain.com

# 決済（将来対応）
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ファイルストレージ
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=teralog-assets

# アプリ設定
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 本番URL（OGP・OAuth リダイレクト・メール確認に使用）
NEXT_PUBLIC_SITE_URL=https://teralog.app
NODE_ENV=development

# Seed データ用（npm run db:seed 実行前に設定）
PILOT_ADMIN_EMAIL=admin@your-temple.example
PILOT_DANKA_EMAIL=danka@your-temple.example
PILOT_GOEN_EMAIL=goen@your-temple.example

# スクリーンショット取得用（npm run screenshots 実行前に設定）
SCREENSHOT_BASE_URL=http://localhost:3000
SCREENSHOT_ADMIN_EMAIL=admin@your-temple.example
SCREENSHOT_ADMIN_PASS=
SCREENSHOT_DANKA_EMAIL=danka@your-temple.example
SCREENSHOT_DANKA_PASS=
SCREENSHOT_GOEN_EMAIL=goen@your-temple.example
SCREENSHOT_GOEN_PASS=
