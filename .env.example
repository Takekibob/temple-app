# ==========================================
# てらログ 環境変数テンプレート
# .env.local にコピーして値を設定してください
# ==========================================

# ── Supabase ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Supabase PostgreSQL direct connection)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── 認証・セキュリティ ──────────────────────
# SUPER_ADMIN（プラットフォーム運営者）
# このメールアドレスのみ /superadmin/init から SUPER_ADMIN 登録が可能
SUPER_ADMIN_EMAIL=your-admin@example.com
# 本番URL（OGP・OAuth リダイレクト・メール確認に使用）
NEXT_PUBLIC_SITE_URL=https://teralog.app

# ── 決済（Stripe）──────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...           # イベント参加費 Checkout Webhook

# ── LINE Messaging API ─────────────────────
# LINE Developers Console (https://developers.line.biz/) でチャネルを作成して取得
# Messaging API チャネル > チャネルシークレット / チャネルアクセストークン（長期）
# Webhook URL に登録: https://[your-domain]/api/line/webhook
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token

# ── Web Push / VAPID ───────────────────────
# 初回セットアップ: npx web-push generate-vapid-keys
# 生成された Public Key → NEXT_PUBLIC_VAPID_PUBLIC_KEY
# 生成された Private Key → VAPID_PRIVATE_KEY（公開・コミット禁止）
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:info@teralog.app

# ── メール送信（Resend）────────────────────
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@teralog.app

# ── Cron 認証 ──────────────────────────────
CRON_SECRET=your-cron-secret

# ── ファイルストレージ ──────────────────────
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=teralog-assets

# ── 開発 / Seed データ ─────────────────────
NODE_ENV=development

# prisma/seed.ts 用（npm run db:seed 実行前に設定）
PILOT_ADMIN_EMAIL=admin@your-temple.example
PILOT_DANKA_EMAIL=danka@your-temple.example
PILOT_GOEN_EMAIL=goen@your-temple.example
# 第2デモ寺院（マルチテンプル検証用）
DEMO2_ADMIN_EMAIL=admin2@your-temple.example
DEMO2_DANKA_EMAIL=danka2@your-temple.example

# スクリーンショット取得用（npm run screenshots 実行前に設定）
SCREENSHOT_BASE_URL=http://localhost:3000
SCREENSHOT_ADMIN_EMAIL=admin@your-temple.example
SCREENSHOT_ADMIN_PASS=
SCREENSHOT_DANKA_EMAIL=danka@your-temple.example
SCREENSHOT_DANKA_PASS=
SCREENSHOT_GOEN_EMAIL=goen@your-temple.example
SCREENSHOT_GOEN_PASS=
