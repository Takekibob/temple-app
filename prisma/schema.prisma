// てらログ - Prisma Schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 寺院
// ==========================================
model Temple {
  id           String   @id @default(uuid())
  name         String
  denomination String? // 宗派
  address      String?
  phone        String?
  email        String?
  logoUrl      String?
  description  String? // 寺院紹介文

  // マルチテンプル対応（追加フィールド）
  coverImageUrl String? // カバー画像URL
  latitude      Decimal? // 緯度（将来の地図表示用）
  longitude     Decimal? // 経度（将来の地図表示用）
  isActive      Boolean  @default(true)

  // 予約設定
  bookingStartTime   String  @default("09:00")
  bookingEndTime     String  @default("17:00")
  bookingDuration    Int     @default(60)
  bookingMaxSlots    Int     @default(1)
  bookingAdvanceDays Int     @default(1)

  // 通知設定
  reminderDayBefore     Boolean @default(true)
  reminderDayBeforeTime String  @default("18:00")
  reminderDayOf         Boolean @default(true)
  reminderDayOfTime     String  @default("09:00")
  reminderMeinichi      Boolean @default(true)

  // カスタムカテゴリ
  customEventCategories Json    @default("[]")

  // サブスクリプション管理
  planStatus           PlanStatus @default(TRIAL)
  trialEndsAt          DateTime?
  stripeCustomerId     String?    @unique
  stripeSubscriptionId String?    @unique

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]
  members      Member[]
  reservations Reservation[]
  events       Event[]
  ofuse        Ofuse[]
  announcements Announcement[]
  annualEvents AnnualEvent[]
  gojikaiRules GojikaiRule[]
  pushSubscriptions PushSubscription[]
  favoriteByMembers MemberFavoriteTemple[]

  @@map("temples")
}

// ==========================================
// ユーザー（認証アカウント）
// ==========================================
model User {
  id           String   @id @default(uuid())
  templeId     String?  // NULL = SUPER_ADMIN（特定のお寺に属さない）
  role         Role     @default(MEMBER)
  name         String
  email        String   @unique
  phone        String?
  passwordHash String?
  authProvider AuthProvider @default(EMAIL)
  pushToken    String?
  pushEnabled  Boolean  @default(true)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  temple  Temple?  @relation(fields: [templeId], references: [id])
  member  Member?
  pushSubscriptions PushSubscription[]

  @@map("users")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
  MEMBER

  @@map("role")
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
  LINE

  @@map("auth_provider")
}

// ==========================================
// 会員（檀家 + ご縁さん統合）
// ==========================================
model Member {
  id               String     @id @default(uuid())
  templeId         String?    // NULLable: 檀家は必須、ご縁さんはNULL
  userId           String     @unique
  type             MemberType @default(GOEN)
  familyName       String
  address          String?
  postalCode       String?
  phone            String?
  email            String?
  joinedDate       DateTime   @default(now())
  interestTags     Json?      // ["zazen","shakyo","yoga"]
  referralSource   ReferralSource?
  engagementScore  Int        @default(0)
  promotedAt       DateTime?  // ご縁さん→檀家に昇格した日時
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  lineUserId          String?   // LINE連携後に設定されるLINEユーザーID
  lineNotifyEnabled   Boolean   @default(false)
  lineCode            String?   // 連携コード（一時保存）
  lineCodeExpiresAt   DateTime? // 連携コード有効期限
  notifyReservation   Boolean   @default(true)
  notifyEvent         Boolean   @default(true)
  notifyAnniversary   Boolean   @default(true)
  notifyAnnouncement  Boolean   @default(true)

  temple           Temple?    @relation(fields: [templeId], references: [id])
  user             User       @relation(fields: [userId], references: [id])
  deceasedPersons  DeceasedPerson[]
  reservations     Reservation[]
  ofuse            Ofuse[]
  gojikaiPayments  GojikaiPayment[]
  eventParticipations EventParticipation[]
  interactions     MemberInteraction[]
  activities       MemberActivity[]
  favoriteTemples  MemberFavoriteTemple[]

  @@map("members")
}

enum MemberType {
  DANKA // 檀家
  GOEN  // ご縁さん

  @@map("member_type")
}

enum ReferralSource {
  SNS
  WEB
  EVENT
  INTRODUCTION
  WALK_IN
  OTHER

  @@map("referral_source")
}

// ==========================================
// お気に入り寺院（ご縁さんが寺院をフォロー）
// ==========================================
model MemberFavoriteTemple {
  id        String   @id @default(uuid())
  memberId  String
  templeId  String
  createdAt DateTime @default(now())

  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  temple    Temple   @relation(fields: [templeId], references: [id], onDelete: Cascade)

  @@unique([memberId, templeId])
  @@map("member_favorite_temples")
}

// ==========================================
// 故人（過去帳）
// ==========================================
model DeceasedPerson {
  id            String    @id @default(uuid())
  memberId      String
  name          String    // 俗名
  kaimyo        String?   // 戒名
  deathDate     DateTime?
  birthDate     DateTime?
  age           Int?      // 享年
  relationship  String?   // 続柄
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  member        Member    @relation(fields: [memberId], references: [id])
  reservations  Reservation[]

  @@map("deceased_persons")
}

// ==========================================
// 予約（法要・供養）
// ==========================================
model Reservation {
  id                String            @id @default(uuid())
  templeId          String
  memberId          String
  type              ReservationType
  scheduledAt       DateTime
  durationMin       Int               @default(60)
  deceasedPersonId  String?
  status            ReservationStatus @default(PENDING)
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  temple          Temple          @relation(fields: [templeId], references: [id])
  member          Member          @relation(fields: [memberId], references: [id])
  deceasedPerson  DeceasedPerson? @relation(fields: [deceasedPersonId], references: [id])
  ofuse           Ofuse[]

  @@map("reservations")
}

enum ReservationType {
  ANNUAL_MEMORIAL  // 年忌法要
  MONTHLY_MEMORIAL // 月命日
  NIBON            // 新盆
  KUYO             // 供養
  FUNERAL          // 葬儀
  OTHER

  @@map("reservation_type")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED

  @@map("reservation_status")
}

// ==========================================
// イベント
// ==========================================
model Event {
  id          String        @id @default(uuid())
  templeId    String
  title       String
  description String?
  category    String        // 標準: ZAZEN/SHAKYO/YOGA/MINDFULNESS/LECTURE/SEASONAL/OTHER、カスタム: 日本語名
  eventDate   DateTime
  startTime   String        // HH:MM
  endTime     String        // HH:MM
  location    String?
  capacity    Int?          // NULL = 無制限
  fee         Int           @default(0)
  visibility  EventVisibility @default(PUBLIC)
  imageUrl    String?
  shareUrl    String?
  status      EventStatus   @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  temple        Temple       @relation(fields: [templeId], references: [id])
  participations EventParticipation[]

  @@map("events")
}


enum EventVisibility {
  PUBLIC         // 誰でも
  MEMBERS_ONLY   // 廃止予定（既存データ互換性のために残存）→ PUBLIC と同等に扱う
  DANKA_ONLY     // 檀家限定（自寺院の檀家のみ）

  @@map("event_visibility")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  COMPLETED
  CANCELLED

  @@map("event_status")
}

// ==========================================
// イベント参加申込
// ==========================================
model EventParticipation {
  id              String            @id @default(uuid())
  eventId         String
  memberId        String
  numGuests       Int               @default(1)
  status          ParticipationStatus @default(APPLIED)
  paymentStatus   PaymentStatus     @default(NOT_REQUIRED)
  paymentAmount         Int               @default(0)
  stripeSessionId       String?
  stripePaymentIntentId String?
  feedbackScore   Int?              // 1-5
  feedbackComment String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  event   Event  @relation(fields: [eventId], references: [id])
  member  Member @relation(fields: [memberId], references: [id])

  @@unique([eventId, memberId])
  @@map("event_participations")
}

enum ParticipationStatus {
  APPLIED      // 申込
  CONFIRMED    // 確定
  WAITLISTED   // キャンセル待ち
  ATTENDED     // 参加済
  NO_SHOW      // 不参加
  CANCELLED

  @@map("participation_status")
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  REFUNDED

  @@map("payment_status")
}

// ==========================================
// お布施
// ==========================================
model Ofuse {
  id              String        @id @default(uuid())
  templeId        String
  memberId        String
  reservationId   String?
  type            OfuseType
  amount          Int
  paidAt          DateTime
  paymentMethod   PaymentMethod @default(CASH)
  receiptIssued   Boolean       @default(false)
  notes           String?
  createdAt       DateTime      @default(now())

  temple      Temple       @relation(fields: [templeId], references: [id])
  member      Member       @relation(fields: [memberId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])

  @@map("ofuse")
}

enum OfuseType {
  HOUYO      // 法要
  GOJIKAI    // 護持会費
  KIFU       // 寄付
  EVENT_FEE  // イベント参加費
  OTHER

  @@map("ofuse_type")
}

enum PaymentMethod {
  CASH
  TRANSFER
  ONLINE

  @@map("payment_method")
}

// ==========================================
// 護持会費
// ==========================================
model GojikaiRule {
  id         String   @id @default(uuid())
  templeId   String
  amount     Int
  dueMonth   Int      @default(3) // 毎年何月に請求
  createdAt  DateTime @default(now())

  temple   Temple           @relation(fields: [templeId], references: [id])

  @@map("gojikai_rules")
}

model GojikaiPayment {
  id          String        @id @default(uuid())
  memberId    String
  fiscalYear  Int
  amount      Int
  status      GojikaiStatus @default(UNPAID)
  paidAt      DateTime?
  dueDate     DateTime?
  createdAt   DateTime      @default(now())

  member  Member @relation(fields: [memberId], references: [id])

  @@unique([memberId, fiscalYear])
  @@map("gojikai_payments")
}

enum GojikaiStatus {
  UNPAID
  PAID
  EXEMPT

  @@map("gojikai_status")
}

// ==========================================
// お知らせ
// ==========================================
model Announcement {
  id            String           @id @default(uuid())
  templeId      String
  title         String
  body          String
  targetSegment AnnouncementTarget @default(ALL)
  publishedAt   DateTime?
  pushSent      Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  temple  Temple @relation(fields: [templeId], references: [id])

  @@map("announcements")
}

enum AnnouncementTarget {
  ALL
  DANKA
  GOEN

  @@map("announcement_target")
}

// ==========================================
// 年中行事
// ==========================================
model AnnualEvent {
  id             String   @id @default(uuid())
  templeId       String
  name           String
  month          Int
  day            Int
  endDay         Int?     // 複数日イベントの最終日（同月内）
  description    String?
  isRecurring    Boolean  @default(true)
  showOnCalendar Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())

  temple  Temple @relation(fields: [templeId], references: [id])

  @@map("annual_events")
}

// ==========================================
// 対応履歴（CRMメモ）
// ==========================================
model MemberInteraction {
  id        String   @id @default(uuid())
  memberId  String
  staffNote String
  category  String?
  createdAt DateTime @default(now())

  member  Member @relation(fields: [memberId], references: [id])

  @@map("member_interactions")
}

// ==========================================
// アクティビティログ（エンゲージメントスコア計算用）
// ==========================================
model MemberActivity {
  id        String       @id @default(uuid())
  memberId  String
  type      ActivityType
  metadata  Json?        // { eventId, title, etc. }
  score     Int          @default(0)
  createdAt DateTime     @default(now())

  member    Member       @relation(fields: [memberId], references: [id])

  @@index([memberId, createdAt])
  @@map("member_activities")
}

enum ActivityType {
  LOGIN
  NEWS_VIEW
  EVENT_APPLY
  EVENT_ATTEND
  EVENT_FEEDBACK
  KUYO_APPLY
  CONTACT
  CONSECUTIVE_MONTH

  @@map("activity_type")
}

// ==========================================
// SUPER_ADMIN 操作ログ
// ==========================================
model SuperAdminLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String   // PLAN_CHANGE, TEMPLE_CREATE, TEMPLE_SUSPEND, etc.
  targetType String   // TEMPLE, USER, etc.
  targetId   String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@map("super_admin_logs")
}

// ==========================================
// プランステータス
// ==========================================
enum PlanStatus {
  TRIAL       // トライアル中
  ACTIVE      // 有効（課金中）
  PAST_DUE    // 支払い遅延
  CANCELLED   // 解約済み
  SUSPENDED   // 停止（管理者による強制停止）

  @@map("plan_status")
}

// ==========================================
// プッシュ通知サブスクリプション
// ==========================================
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  templeId  String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  temple Temple @relation(fields: [templeId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}
