// てらログ - Prisma Schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 寺院
// ==========================================
model Temple {
  id           String   @id @default(uuid())
  name         String
  denomination String? // 宗派
  address      String?
  phone        String?
  email        String?
  logoUrl      String?
  description  String? // 寺院紹介文

  // マルチテンプル対応（追加フィールド）
  coverImageUrl String? // カバー画像URL
  websiteUrl    String? // 公式サイトURL
  latitude      Decimal? // 緯度（将来の地図表示用）
  longitude     Decimal? // 経度（将来の地図表示用）
  isActive      Boolean  @default(true)

  // 予約設定
  bookingStartTime   String  @default("09:00")
  bookingEndTime     String  @default("17:00")
  bookingDuration    Int     @default(60)
  bookingMaxSlots    Int     @default(1)
  bookingAdvanceDays Int     @default(1)

  // 通知設定
  reminderDayBefore     Boolean @default(true)
  reminderDayBeforeTime String  @default("18:00")
  reminderDayOf         Boolean @default(true)
  reminderDayOfTime     String  @default("09:00")
  reminderMeinichi      Boolean @default(true)

  // カスタムカテゴリ
  customEventCategories Json    @default("[]")

  // サブスクリプション管理
  planStatus           PlanStatus @default(TRIAL)
  trialEndsAt          DateTime?
  stripeCustomerId     String?    @unique
  stripeSubscriptionId String?    @unique

  // Stripe Connect（各寺院への寄付受け取り）
  stripeConnectAccountId  String?  @unique
  stripeConnectOnboarded  Boolean  @default(false)

  // --- v2追加：ステージ閾値カスタマイズ ---
  thresholdGoen      Int @default(10)  // → PROSPECT遷移スコア
  thresholdProspect  Int @default(50)  // → DANKA_CANDIDATE遷移スコア
  thresholdCandidate Int @default(80)  // 住職通知スコア
  dankaGoalAnnual    Int?              // 年間檀家増加目標

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]
  members      Member[]
  reservations Reservation[]
  events       Event[]
  ofuse        Ofuse[]
  announcements Announcement[]
  annualEvents AnnualEvent[]
  gojikaiRules GojikaiRule[]
  pushSubscriptions PushSubscription[]
  favoriteByMembers MemberFavoriteTemple[]
  blogPosts    BlogPost[]
  reservationBlocks ReservationBlock[]
  activityLogs ActivityLog[]
  scoringRules ScoringRule[]
  membershipPlans    MembershipPlan[]
  donations          Donation[]
  lineMessages       LineMessage[]
  lineStepSequences  LineStepSequence[]
  ocrRequests        OcrRequest[]
  onboardingPacks    OnboardingPack[]
  analyticsSnapshots AnalyticsSnapshot[]
  memberNotes        MemberNote[]
  memberChangeRequests MemberChangeRequest[]

  @@map("temples")
}

// ==========================================
// ユーザー（認証アカウント）
// ==========================================
model User {
  id           String   @id @default(uuid())
  templeId     String?  // NULL = SUPER_ADMIN（特定のお寺に属さない）
  role         Role     @default(MEMBER)
  name         String
  email        String   @unique
  phone        String?
  authProvider AuthProvider @default(EMAIL)
  pushEnabled  Boolean  @default(true)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?

  // --- v2追加：表示設定（高齢者対策） ---
  displayMode  DisplayMode @default(STANDARD)
  fontSize     FontSize    @default(MEDIUM)
  highContrast Boolean     @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  temple  Temple?  @relation(fields: [templeId], references: [id])
  member  Member?
  pushSubscriptions PushSubscription[]
  activityLogs ActivityLog[]
  proxyMembers Member[] @relation("ProxyMembers")
  memberNotes  MemberNote[]
  reviewedChangeRequests MemberChangeRequest[]

  @@map("users")
}

enum DisplayMode {
  STANDARD
  SIMPLE

  @@map("display_mode")
}

enum FontSize {
  MEDIUM
  LARGE
  XLARGE

  @@map("font_size")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
  MEMBER

  @@map("role")
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
  LINE

  @@map("auth_provider")
}

// ==========================================
// 会員（檀家 + ご縁さん統合）
// ==========================================
model Member {
  id               String     @id @default(uuid())
  templeId         String?    // NULLable: 檀家は必須、ご縁さんはNULL
  userId           String     @unique
  type             MemberType @default(GOEN)
  familyName       String
  address          String?
  postalCode       String?
  phone            String?
  email            String?
  joinedDate       DateTime   @default(now())
  interestTags     Json?      // ["zazen","shakyo","yoga"]
  referralSource   ReferralSource?
  engagementScore  Int        @default(0)
  promotedAt       DateTime?  // ご縁さん→檀家に昇格した日時
  notes            String?
  summaryNote      String?    // 一行概要メモ（一覧表示用）
  priorityTags     String[]   @default([]) // ["要フォロー","VIP","要注意"]
  lastContactAt    DateTime?  // 最終接触日（離脱検知用）— INTERACTION メモ・予約・お布施で更新
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // パイプライン・ステージ管理
  stage               MemberStage @default(GOEN)
  stageChangedAt      DateTime?
  stageChangedBy      String?   // userId or "AUTO"
  lifetimeScore       Int       @default(0)
  firstContactAt      DateTime?
  lastActivityAt      DateTime?
  totalEventsAttended Int       @default(0)
  totalDonations      Int       @default(0)
  totalPayments       Int       @default(0)

  // --- v2追加：代理アカウント（高齢者対策） ---
  proxyUserId   String?
  proxyRelation String?  // 'child', 'grandchild', 'spouse', 'other'
  sourceDetail  String?  // 流入経路の補足（紹介者名等）

  lineUserId          String?   // LINE連携後に設定されるLINEユーザーID
  lineNotifyEnabled   Boolean   @default(false)
  lineCode            String?   // 連携コード（一時保存）
  lineCodeExpiresAt   DateTime? // 連携コード有効期限
  notifyReservation   Boolean   @default(true)
  notifyEvent         Boolean   @default(true)
  notifyAnniversary   Boolean   @default(true)
  notifyAnnouncement  Boolean   @default(true)

  temple           Temple?    @relation(fields: [templeId], references: [id])
  user             User       @relation(fields: [userId], references: [id])
  proxyUser        User?      @relation("ProxyMembers", fields: [proxyUserId], references: [id])
  deceasedPersons  DeceasedPerson[]
  reservations     Reservation[]
  ofuse            Ofuse[]
  gojikaiPayments  GojikaiPayment[]
  eventParticipations EventParticipation[]
  activities       MemberActivity[]
  favoriteTemples  MemberFavoriteTemple[]
  stageTransitions StageTransition[]
  scoringEvents    ScoringEvent[]
  subscriptions    MemberSubscription[]
  donations        Donation[]
  lineStepQueues   LineStepQueue[]
  memberNotes      MemberNote[]
  announcements    Announcement[]
  changeRequests   MemberChangeRequest[]

  @@map("members")
}

enum MemberType {
  DANKA // 檀家
  GOEN  // ご縁さん

  @@map("member_type")
}

enum MemberStage {
  GOEN            // ご縁さん（初期）
  PROSPECT        // 見込み
  DANKA_CANDIDATE // 檀家候補
  DANKA           // 檀家

  @@map("member_stage")
}

enum ReferralSource {
  SNS
  WEB
  EVENT
  INTRODUCTION
  WALK_IN
  OTHER

  @@map("referral_source")
}

// ==========================================
// お気に入り寺院（ご縁さんが寺院をフォロー）
// ==========================================
model MemberFavoriteTemple {
  id        String   @id @default(uuid())
  memberId  String
  templeId  String
  createdAt DateTime @default(now())

  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  temple    Temple   @relation(fields: [templeId], references: [id], onDelete: Cascade)

  @@unique([memberId, templeId])
  @@map("member_favorite_temples")
}

// ==========================================
// 故人（過去帳）
// ==========================================
model DeceasedPerson {
  id            String    @id @default(uuid())
  memberId      String
  name          String    // 俗名
  kaimyo        String?   // 戒名
  deathDate     DateTime?
  birthDate     DateTime?
  age           Int?      // 享年
  relationship  String?   // 続柄
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  member        Member    @relation(fields: [memberId], references: [id])
  reservations  Reservation[]

  @@map("deceased_persons")
}

// ==========================================
// 予約（法要・供養）
// ==========================================
model Reservation {
  id                String            @id @default(uuid())
  templeId          String
  memberId          String
  type              ReservationType
  scheduledAt       DateTime
  durationMin       Int               @default(60)
  deceasedPersonId  String?
  status            ReservationStatus @default(PENDING)
  notes             String?
  // 参加人数・オプション
  attendees         Int?
  purificationRequired Boolean        @default(false)
  flowerOrder       Boolean           @default(false)
  flowerDetail      String?
  cateringOrder     Boolean           @default(false)
  cateringCount     Int?
  cateringDetail    String?
  memberEditedAt    DateTime?         // 利用者が内容変更した最終日時
  isAdminCreated    Boolean           @default(false) // 管理者代理入力
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  temple          Temple          @relation(fields: [templeId], references: [id])
  member          Member          @relation(fields: [memberId], references: [id])
  deceasedPerson  DeceasedPerson? @relation(fields: [deceasedPersonId], references: [id])
  ofuse           Ofuse[]

  @@map("reservations")
}

// ==========================================
// 予約不可ブロック
// ==========================================
model ReservationBlock {
  id        String   @id @default(uuid())
  templeId  String
  date      String   // YYYY-MM-DD
  startTime String?  // HH:MM (null = 全日)
  endTime   String?  // HH:MM (null = 全日)
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  temple Temple @relation(fields: [templeId], references: [id])

  @@map("reservation_blocks")
}

enum ReservationType {
  ANNUAL_MEMORIAL  // 年忌法要
  MONTHLY_MEMORIAL // 月命日
  NIBON            // 新盆
  KUYO             // 供養
  FUNERAL          // 葬儀
  OTHER

  @@map("reservation_type")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED

  @@map("reservation_status")
}

// ==========================================
// イベント
// ==========================================
model Event {
  id          String        @id @default(uuid())
  templeId    String
  title       String
  description String?
  category    String        // 標準: ZAZEN/SHAKYO/YOGA/MINDFULNESS/LECTURE/SEASONAL/OTHER、カスタム: 日本語名
  eventDate   DateTime
  startTime   String        // HH:MM
  endTime     String        // HH:MM
  location    String?
  capacity    Int?          // NULL = 無制限
  fee         Int           @default(0)
  visibility  EventVisibility @default(PUBLIC)
  imageUrl    String?
  shareUrl    String?
  status      EventStatus   @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  temple        Temple       @relation(fields: [templeId], references: [id])
  participations EventParticipation[]

  @@map("events")
}


enum EventVisibility {
  PUBLIC              // 誰でも
  MEMBERS_ONLY        // 廃止予定（既存データ互換性のために残存）→ PUBLIC と同等に扱う
  DANKA_ONLY          // 檀家限定（自寺院の檀家のみ）
  SUBSCRIBERS_ONLY    // 会員プラン加入者限定

  @@map("event_visibility")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  COMPLETED
  CANCELLED

  @@map("event_status")
}

// ==========================================
// イベント参加申込
// ==========================================
model EventParticipation {
  id              String            @id @default(uuid())
  eventId         String
  memberId        String
  numGuests       Int               @default(1)
  status          ParticipationStatus @default(APPLIED)
  paymentStatus   PaymentStatus     @default(NOT_REQUIRED)
  paymentAmount         Int               @default(0)
  stripeSessionId       String?
  stripePaymentIntentId String?
  feedbackScore   Int?              // 1-5
  feedbackComment String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  event   Event  @relation(fields: [eventId], references: [id])
  member  Member @relation(fields: [memberId], references: [id])

  @@unique([eventId, memberId])
  @@map("event_participations")
}

enum ParticipationStatus {
  APPLIED      // 申込
  CONFIRMED    // 確定
  WAITLISTED   // キャンセル待ち
  ATTENDED     // 参加済
  NO_SHOW      // 不参加
  CANCELLED

  @@map("participation_status")
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  REFUNDED

  @@map("payment_status")
}

// ==========================================
// お布施
// ==========================================
model Ofuse {
  id              String        @id @default(uuid())
  templeId        String
  memberId        String
  reservationId   String?
  type            OfuseType
  amount          Int
  paidAt          DateTime
  paymentMethod   PaymentMethod @default(CASH)
  receiptIssued   Boolean       @default(false)
  notes           String?
  createdAt       DateTime      @default(now())

  temple      Temple       @relation(fields: [templeId], references: [id])
  member      Member       @relation(fields: [memberId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])

  @@map("ofuse")
}

enum OfuseType {
  HOUYO      // 法要
  GOJIKAI    // 護持会費
  KIFU       // 寄付
  EVENT_FEE  // イベント参加費
  OTHER

  @@map("ofuse_type")
}

enum PaymentMethod {
  CASH
  TRANSFER
  ONLINE

  @@map("payment_method")
}

// ==========================================
// 護持会費
// ==========================================
model GojikaiRule {
  id         String   @id @default(uuid())
  templeId   String
  amount     Int
  dueMonth   Int      @default(3) // 毎年何月に請求
  createdAt  DateTime @default(now())

  temple   Temple           @relation(fields: [templeId], references: [id])

  @@map("gojikai_rules")
}

model GojikaiPayment {
  id          String        @id @default(uuid())
  memberId    String
  fiscalYear  Int
  amount      Int
  status      GojikaiStatus @default(UNPAID)
  paidAt      DateTime?
  dueDate     DateTime?
  createdAt   DateTime      @default(now())

  member  Member @relation(fields: [memberId], references: [id])

  @@unique([memberId, fiscalYear])
  @@map("gojikai_payments")
}

enum GojikaiStatus {
  UNPAID
  PAID
  EXEMPT

  @@map("gojikai_status")
}

// ==========================================
// お知らせ
// ==========================================
model Announcement {
  id            String           @id @default(uuid())
  templeId      String
  memberId      String?          // 個人宛通知の場合に設定（nullは全体向け）
  title         String
  body          String
  targetSegment AnnouncementTarget @default(ALL)
  publishedAt   DateTime?
  pushSent      Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  temple  Temple  @relation(fields: [templeId], references: [id])
  member  Member? @relation(fields: [memberId], references: [id])

  @@map("announcements")
}

enum AnnouncementTarget {
  ALL
  DANKA
  GOEN

  @@map("announcement_target")
}

// ==========================================
// 年中行事
// ==========================================
model AnnualEvent {
  id             String   @id @default(uuid())
  templeId       String
  name           String
  month          Int
  day            Int
  endDay         Int?     // 複数日イベントの最終日（同月内）
  description    String?
  isRecurring    Boolean  @default(true)
  showOnCalendar Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())

  temple  Temple @relation(fields: [templeId], references: [id])

  @@map("annual_events")
}

// ==========================================
// アクティビティログ（エンゲージメントスコア計算用）
// ==========================================
model MemberActivity {
  id        String       @id @default(uuid())
  memberId  String
  type      ActivityType
  metadata  Json?        // { eventId, title, etc. }
  score     Int          @default(0)
  createdAt DateTime     @default(now())

  member    Member       @relation(fields: [memberId], references: [id])

  @@index([memberId, createdAt])
  @@map("member_activities")
}

enum ActivityType {
  LOGIN
  NEWS_VIEW
  EVENT_APPLY
  EVENT_ATTEND
  EVENT_FEEDBACK
  KUYO_APPLY
  CONTACT
  CONSECUTIVE_MONTH
  DONATION
  DONATION_LARGE
  SUBSCRIPTION_START
  REFERRAL
  LINE_MESSAGE_OPEN

  @@map("activity_type")
}

// ==========================================
// SUPER_ADMIN 操作ログ
// ==========================================
model SuperAdminLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String   // PLAN_CHANGE, TEMPLE_CREATE, TEMPLE_SUSPEND, etc.
  targetType String   // TEMPLE, USER, etc.
  targetId   String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@map("super_admin_logs")
}

// ==========================================
// プランステータス
// ==========================================
enum PlanStatus {
  FREE        // 無料プラン（永久）
  TRIAL       // トライアル中
  ACTIVE      // 有効（課金中）
  PAST_DUE    // 支払い遅延
  CANCELLED   // 解約済み
  SUSPENDED   // 停止（管理者による強制停止）

  @@map("plan_status")
}

// ==========================================
// プッシュ通知サブスクリプション
// ==========================================
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  templeId  String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  temple Temple @relation(fields: [templeId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}

// ==========================================
// 操作ログ（監査ログ）
// ==========================================
model ActivityLog {
  id         String   @id @default(uuid())
  templeId   String
  userId     String?  // NULL = システム自動処理
  action     String
  // 'create' | 'update' | 'delete' | 'export' | 'import' | 'login' | 'logout' | 'view_sensitive'
  targetType String?
  // 'member' | 'event' | 'reservation' | 'ofuse' | 'settings' | 'gojikai' | 'announcement'
  targetId   String?
  targetName String?  // 人間が読める対象名（例: 「山田 太郎」）
  detail     Json?    // 変更前後の値など
  ipAddress  String?
  createdAt  DateTime @default(now())

  temple Temple  @relation(fields: [templeId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([templeId, createdAt(sort: Desc)])
  @@index([templeId, targetType, targetId])
  @@map("activity_logs")
}

// ==========================================
// スコアリングルール（お寺ごとにカスタマイズ可能）
// ==========================================
model ScoringRule {
  id           String   @id @default(uuid())
  templeId     String
  activityType String   // ActivityType enum value
  score        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  temple       Temple   @relation(fields: [templeId], references: [id], onDelete: Cascade)

  @@unique([templeId, activityType])
  @@map("scoring_rules")
}

// ==========================================
// スコアリングイベント（スコア付与履歴）
// ==========================================
model ScoringEvent {
  id           String   @id @default(uuid())
  memberId     String
  activityType String
  score        Int
  sourceId     String?  // 関連レコードID（eventId, reservationIdなど）
  note         String?
  createdAt    DateTime @default(now())

  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
  @@map("scoring_events")
}

// ==========================================
// ステージ遷移履歴
// ==========================================
model StageTransition {
  id          String       @id @default(uuid())
  memberId    String
  fromStage   MemberStage?
  toStage     MemberStage
  triggeredBy String?      // userId or "AUTO"
  reason      String?
  createdAt   DateTime     @default(now())

  member      Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
  @@map("stage_transitions")
}

// ==========================================
// 会員プラン（サブスクリプション定義）
// ==========================================
model MembershipPlan {
  id              String               @id @default(uuid())
  templeId        String
  temple          Temple               @relation(fields: [templeId], references: [id], onDelete: Cascade)

  templateKey     String?              // 定義済みテンプレートキー（BASIC / MONTHLY_SUPPORT / PREMIUM）

  name            String
  description     String?
  price           Int
  interval        SubscriptionInterval @default(MONTHLY)
  benefits        Json?
  maxMembers      Int?

  stripePriceId   String?
  stripeProductId String?

  isActive        Boolean              @default(true)
  sortOrder       Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  subscriptions   MemberSubscription[]

  @@map("membership_plans")
}

enum SubscriptionInterval {
  MONTHLY
  YEARLY
  ONE_TIME

  @@map("subscription_interval")
}

// ==========================================
// 会員サブスクリプション（加入状態）
// ==========================================
model MemberSubscription {
  id                   String                   @id @default(uuid())
  memberId             String
  member               Member                   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planId               String
  plan                 MembershipPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  templeId             String

  stripeSubscriptionId String?
  stripeCustomerId     String?

  status               MemberSubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  canceledAt           DateTime?
  cancelReason         String?

  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([memberId, status])
  @@index([templeId, status])
  @@map("member_subscriptions")
}

enum MemberSubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED

  @@map("member_subscription_status")
}

// ==========================================
// 寄付
// ==========================================
model Donation {
  id              String          @id @default(uuid())
  templeId        String
  temple          Temple          @relation(fields: [templeId], references: [id], onDelete: Cascade)
  memberId        String?
  member          Member?         @relation(fields: [memberId], references: [id], onDelete: SetNull)

  amount          Int
  purpose         DonationPurpose @default(GENERAL)
  purposeDetail   String?

  paymentMethod   PaymentMethod

  stripePaymentIntentId String?

  donorName       String?
  donorEmail      String?

  thankyouSent    Boolean         @default(false)
  thankyouSentAt  DateTime?

  notes           String?
  donatedAt       DateTime        @default(now())
  createdAt       DateTime        @default(now())

  @@index([templeId, donatedAt(sort: Desc)])
  @@map("donations")
}

enum DonationPurpose {
  GENERAL
  REPAIR
  CEREMONY
  CROWDFUNDING
  OTHER

  @@map("donation_purpose")
}

// ==========================================
// LINE配信履歴
// ==========================================
model LineMessage {
  id              String            @id @default(uuid())
  templeId        String
  temple          Temple            @relation(fields: [templeId], references: [id], onDelete: Cascade)

  messageType     LineMessageType
  targetStage     MemberStage?
  targetMemberIds String[]

  content         Json

  sentCount       Int               @default(0)
  deliveredCount  Int               @default(0)
  openedCount     Int               @default(0)

  scheduledAt     DateTime?
  sentAt          DateTime?
  status          LineMessageStatus @default(DRAFT)

  createdBy       String?
  createdAt       DateTime          @default(now())

  @@index([templeId, createdAt(sort: Desc)])
  @@map("line_messages")
}

enum LineMessageType {
  BROADCAST
  SEGMENT
  INDIVIDUAL
  STEP
  REMINDER
  THANKYOU

  @@map("line_message_type")
}

enum LineMessageStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED

  @@map("line_message_status")
}

// ==========================================
// LINEステップ配信シーケンス
// ==========================================
model LineStepSequence {
  id        String          @id @default(uuid())
  templeId  String
  temple    Temple          @relation(fields: [templeId], references: [id], onDelete: Cascade)

  name      String
  trigger   LineStepTrigger

  steps     Json

  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  queues    LineStepQueue[]

  @@map("line_step_sequences")
}

enum LineStepTrigger {
  FIRST_EVENT_ATTEND
  LINE_REGISTER
  STAGE_CHANGE_PROSPECT
  STAGE_CHANGE_CANDIDATE
  DONATION_FIRST

  @@map("line_step_trigger")
}

// ==========================================
// LINEステップ配信キュー
// ==========================================
model LineStepQueue {
  id          String          @id @default(uuid())
  sequenceId  String
  sequence    LineStepSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  memberId    String
  member      Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  templeId    String

  currentStep Int             @default(0)
  nextSendAt  DateTime
  status      StepQueueStatus @default(PENDING)

  startedAt   DateTime        @default(now())
  completedAt DateTime?

  @@index([nextSendAt, status])
  @@map("line_step_queues")
}

enum StepQueueStatus {
  PENDING
  COMPLETED
  CANCELLED

  @@map("step_queue_status")
}

// ==========================================
// OCR取り込みリクエスト
// ==========================================
model OcrRequest {
  id            String           @id @default(uuid())
  templeId      String
  temple        Temple           @relation(fields: [templeId], references: [id], onDelete: Cascade)

  requestType   OcrRequestType
  fileUrls      String[]
  status        OcrRequestStatus @default(SUBMITTED)
  extractedData Json?
  importedCount Int              @default(0)

  notes         String?
  submittedBy   String?
  processedBy   String?

  submittedAt   DateTime         @default(now())
  completedAt   DateTime?

  @@index([templeId, submittedAt(sort: Desc)])
  @@map("ocr_requests")
}

enum OcrRequestStatus {
  SUBMITTED
  PROCESSING
  REVIEW
  COMPLETED
  FAILED

  @@map("ocr_request_status")
}

enum OcrRequestType {
  KAKOCHO
  MEIBO
  OTHER

  @@map("ocr_request_type")
}

// ==========================================
// 導入おまかせパック
// ==========================================
model OnboardingPack {
  id        String               @id @default(uuid())
  templeId  String
  temple    Temple               @relation(fields: [templeId], references: [id], onDelete: Cascade)

  status    OnboardingPackStatus @default(REQUESTED)

  hearingDone   Boolean   @default(false)
  hearingDate   DateTime?
  hearingNotes  String?

  dataEntryDone  Boolean  @default(false)
  dataEntryCount Int      @default(0)

  lineSetupDone  Boolean  @default(false)
  trainingDone   Boolean  @default(false)
  trainingDate   DateTime?

  supportEndsAt  DateTime?

  stripePaymentIntentId String?
  paidAmount     Int?
  paidAt         DateTime?

  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("onboarding_packs")
}

enum OnboardingPackStatus {
  REQUESTED
  IN_PROGRESS
  DATA_ENTRY
  LINE_SETUP
  TRAINING
  SUPPORT_PERIOD
  COMPLETED

  @@map("onboarding_pack_status")
}


// ==========================================
// 分析スナップショット（日次集計）
// ==========================================
model AnalyticsSnapshot {
  id           String   @id @default(uuid())
  templeId     String
  temple       Temple   @relation(fields: [templeId], references: [id], onDelete: Cascade)

  snapshotDate DateTime @db.Date
  periodType   String

  metrics      Json

  @@unique([templeId, snapshotDate, periodType])
  @@index([templeId, snapshotDate(sort: Desc)])
  @@map("analytics_snapshots")
}

// ==========================================
// 檀家メモ・対応履歴
// ==========================================
model MemberNote {
  id        String   @id @default(uuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  templeId  String
  temple    Temple   @relation(fields: [templeId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])

  noteType  NoteType @default(MEMO)
  title     String?               // 対応履歴・フォローの見出し
  content   String                // 本文
  tags      String[] @default([]) // ["要フォロー","VIP","要注意","体調注意","遠方","一人暮らし","跡継ぎ不在"]

  followupDate DateTime? @db.Date // フォロー予定日
  isResolved   Boolean   @default(false) // フォロー完了
  isPinned     Boolean   @default(false) // ピン留め

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([templeId])
  @@index([followupDate])
  @@map("member_notes")
}

enum NoteType {
  MEMO        // 一般メモ
  INTERACTION // 対応履歴
  FOLLOWUP    // フォロー予定

  @@map("note_type")
}


// ==========================================
// 機能利用ログ
// ==========================================
model FeatureLog {
  id        String   @id @default(uuid())
  templeId  String
  userId    String
  feature   String   // "member_notes", "tag_filter", "dashboard_widget" など
  action    String   // "create", "edit", "delete", "pin", "view", "click" など

  createdAt DateTime @default(now())

  @@index([templeId])
  @@index([feature])
  @@index([createdAt])
  @@map("feature_logs")
}

// ==========================================
// ブログ記事
// ==========================================
model BlogPost {
  id               String    @id @default(uuid())
  templeId         String
  temple           Temple    @relation(fields: [templeId], references: [id], onDelete: Cascade)

  title            String
  body             String    // プレーンテキスト or Markdown
  coverImageUrl    String?
  isSubscriberOnly Boolean   @default(false)  // true = 会員プラン加入者のみ閲覧可
  status           BlogPostStatus @default(DRAFT)
  publishedAt      DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([templeId, status, publishedAt])
  @@map("blog_posts")
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED

  @@map("blog_post_status")
}

// ==========================================
// 檀家情報変更申請
// ==========================================
model MemberChangeRequest {
  id             String              @id @default(uuid())
  memberId       String
  templeId       String
  status         ChangeRequestStatus @default(PENDING)
  requestData    Json                // { familyName?, address?, postalCode?, phone?, email? }
  reviewedBy     String?
  reviewedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  member   Member @relation(fields: [memberId], references: [id])
  temple   Temple @relation(fields: [templeId], references: [id])
  reviewer User?  @relation(fields: [reviewedBy], references: [id])

  @@index([templeId, status])
  @@map("member_change_requests")
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("change_request_status")
}
