// てらログ - Prisma Schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 寺院
// ==========================================
model Temple {
  id           String   @id @default(uuid())
  name         String
  denomination String? // 宗派
  address      String?
  phone        String?
  email        String?
  logoUrl      String?
  description  String? // 寺院紹介文
  prefecture   String? // 都道府県

  // マルチテンプル対応
  coverImageUrl   String?  // カバー画像URL
  websiteUrl      String?  // 公式サイトURL
  instagramUrl    String?  // Instagram公式アカウントURL
  lineOfficialUrl String?  // LINE公式アカウントURL
  youtubeUrl      String?  // YouTubeチャンネルURL
  latitude        Decimal? // 緯度（将来の地図表示用）
  longitude       Decimal? // 経度（将来の地図表示用）
  isActive        Boolean  @default(true)

  // カスタムカテゴリ
  customEventCategories Json @default("[]")

  // オンライン決済（イベント参加費）
  onlinePaymentEnabled    Boolean @default(false)
  stripeConnectAccountId  String? @unique
  stripeConnectOnboarded  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  members           Member[]
  events            Event[]
  announcements     Announcement[]
  pushSubscriptions PushSubscription[]
  favoriteByMembers MemberFavoriteTemple[]
  activityLogs      ActivityLog[]
  lineMessages      LineMessage[]
  templeVisits      TempleVisit[]
  posts             TemplePost[]
  articles          Article[]

  @@index([latitude, longitude])
  @@map("temples")
}

// ==========================================
// ユーザー（認証アカウント）
// ==========================================
model User {
  id           String       @id @default(uuid())
  templeId     String?      // NULL = SUPER_ADMIN（特定のお寺に属さない）
  role         Role         @default(MEMBER)
  name         String
  email        String       @unique
  phone        String?
  authProvider AuthProvider @default(EMAIL)
  pushEnabled  Boolean      @default(true)
  isActive     Boolean      @default(true)
  lastLoginAt  DateTime?

  // 表示設定（高齢者対策）
  displayMode  DisplayMode @default(STANDARD)
  fontSize     FontSize    @default(MEDIUM)
  highContrast Boolean     @default(false)

  avatarUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  temple            Temple?            @relation(fields: [templeId], references: [id])
  member            Member?
  pushSubscriptions PushSubscription[]
  activityLogs      ActivityLog[]
  proxyMembers      Member[]           @relation("ProxyMembers")
  authoredPosts     TemplePost[]
  articles          Article[]          @relation("ArticleAuthor")
  journals          Journal[]

  @@map("users")
}

enum DisplayMode {
  STANDARD
  SIMPLE

  @@map("display_mode")
}

enum FontSize {
  MEDIUM
  LARGE
  XLARGE

  @@map("font_size")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
  MEMBER

  @@map("role")
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
  LINE

  @@map("auth_provider")
}

// ==========================================
// 会員
// NOTE: type フィールドはSupabase RLSポリシーが依存するため残存（@deprecated）
// ==========================================
model Member {
  id             String         @id @default(uuid())
  templeId       String?        // NULL可: フォロー中のメインお寺（任意）
  userId         String         @unique
  // @deprecated — RLSポリシー依存のため削除不可。新規コードでは参照しないこと
  type           MemberType     @default(GOEN)
  promotedAt     DateTime?      // @deprecated
  familyName     String
  address        String?
  postalCode     String?
  phone          String?
  email          String?
  joinedDate     DateTime       @default(now())
  engagementScore Int           @default(0)
  interestTags    Json?         // ["zazen","shakyo","yoga"]
  referralSource  ReferralSource?
  notes           String?
  summaryNote     String?       // 一行概要メモ（一覧表示用）
  priorityTags    String[]      @default([]) // ["要フォロー","VIP","要注意"]
  lastContactAt   DateTime?     // 最終接触日
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // 代理アカウント（高齢者対策）
  proxyUserId   String?
  proxyRelation String?  // 'child', 'grandchild', 'spouse', 'other'
  sourceDetail  String?  // 流入経路の補足（紹介者名等）

  lineUserId          String?   // LINE連携後に設定されるLINEユーザーID
  lineNotifyEnabled   Boolean   @default(false)
  lineCode            String?   // 連携コード（一時保存）
  lineCodeExpiresAt   DateTime? // 連携コード有効期限
  notifyEvent         Boolean   @default(true)
  notifyAnnouncement  Boolean   @default(true)

  temple              Temple?                @relation(fields: [templeId], references: [id])
  user                User                   @relation(fields: [userId], references: [id])
  proxyUser           User?                  @relation("ProxyMembers", fields: [proxyUserId], references: [id])
  eventParticipations EventParticipation[]
  favoriteTemples     MemberFavoriteTemple[]
  announcementReads   AnnouncementRead[]
  templeVisits        TempleVisit[]
  eventPhotos         EventPhoto[]
  eventReflections    EventReflection[]
  reflectionThanks    EventReflectionThanks[]

  @@map("members")
}

// @deprecated — Supabase RLS ポリシーが依存するため削除不可
// 新規コードでは参照しないこと
enum MemberType {
  DANKA // @deprecated
  GOEN  // @deprecated

  @@map("member_type")
}

enum ReferralSource {
  SNS
  WEB
  EVENT
  INTRODUCTION
  WALK_IN
  OTHER

  @@map("referral_source")
}

// ==========================================
// お気に入り寺院（ご縁さんが寺院をフォロー）
// ==========================================
model MemberFavoriteTemple {
  id        String   @id @default(uuid())
  memberId  String
  templeId  String
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  temple Temple @relation(fields: [templeId], references: [id], onDelete: Cascade)

  @@unique([memberId, templeId])
  @@map("member_favorite_temples")
}

// ==========================================
// イベント
// ==========================================
model Event {
  id          String          @id @default(uuid())
  templeId    String
  title       String
  description String?
  category    String          // 標準: ZAZEN/SHAKYO/YOGA/MINDFULNESS/LECTURE/SEASONAL/OTHER、カスタム: 日本語名
  eventType   EventType       @default(GROUP)
  eventDate   DateTime
  startTime   String          // HH:MM
  endTime     String          // HH:MM
  location    String?
  capacity    Int?            // NULL = 無制限
  fee         Int             @default(0)
  priceMode   PriceMode       @default(FREE)
  imageUrl    String?
  shareUrl    String?
  status      EventStatus     @default(DRAFT)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  temple         Temple               @relation(fields: [templeId], references: [id])
  participations EventParticipation[]
  photos         EventPhoto[]
  reflections    EventReflection[]
  journals       Journal[]

  @@map("events")
}

enum EventType {
  GROUP   // グループイベント（定員制・一斉開催）
  BOOKING // 予約型（個別日程）

  @@map("event_type")
}

enum PriceMode {
  FREE       // 無料
  VOLUNTARY  // お気持ち（任意）
  FIXED      // 金額を指定

  @@map("price_mode")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  COMPLETED
  CANCELLED

  @@map("event_status")
}

// ==========================================
// イベント参加申込
// ==========================================
model EventParticipation {
  id                    String              @id @default(uuid())
  eventId               String
  memberId              String
  numGuests             Int                 @default(1)
  status                ParticipationStatus @default(APPLIED)
  paymentStatus         PaymentStatus       @default(NOT_REQUIRED)
  paymentAmount         Int                 @default(0)
  stripeSessionId       String?
  stripePaymentIntentId String?
  feedbackScore         Int?                // 1-5
  feedbackComment       String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  event  Event  @relation(fields: [eventId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@unique([eventId, memberId])
  @@map("event_participations")
}

enum ParticipationStatus {
  APPLIED    // 申込
  CONFIRMED  // 確定
  WAITLISTED // キャンセル待ち
  ATTENDED   // 参加済
  NO_SHOW    // 不参加
  CANCELLED

  @@map("participation_status")
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  REFUNDED

  @@map("payment_status")
}

// ==========================================
// お知らせ
// ==========================================
model Announcement {
  id          String    @id @default(uuid())
  templeId    String
  title       String
  body        String
  publishedAt DateTime?
  pushSent    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  temple Temple             @relation(fields: [templeId], references: [id])
  reads  AnnouncementRead[]

  @@map("announcements")
}

model AnnouncementRead {
  id             String   @id @default(uuid())
  memberId       String
  announcementId String
  readAt         DateTime @default(now())
  isDeleted      Boolean  @default(false)

  member       Member       @relation(fields: [memberId], references: [id])
  announcement Announcement @relation(fields: [announcementId], references: [id])

  @@unique([memberId, announcementId])
  @@map("announcement_reads")
}

// ==========================================
// SUPER_ADMIN 操作ログ
// ==========================================
model SuperAdminLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String   // PLAN_CHANGE, TEMPLE_CREATE, TEMPLE_SUSPEND, etc.
  targetType String   // TEMPLE, USER, etc.
  targetId   String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@map("super_admin_logs")
}

// ==========================================
// プッシュ通知サブスクリプション
// ==========================================
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  templeId  String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  temple Temple @relation(fields: [templeId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}

// ==========================================
// 操作ログ（監査ログ）
// ==========================================
model ActivityLog {
  id         String   @id @default(uuid())
  templeId   String
  userId     String?  // NULL = システム自動処理
  action     String
  targetType String?
  targetId   String?
  targetName String?
  detail     Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  temple Temple  @relation(fields: [templeId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([templeId, createdAt(sort: Desc)])
  @@index([templeId, targetType, targetId])
  @@map("activity_logs")
}

// ==========================================
// LINE配信履歴
// ==========================================
model LineMessage {
  id              String            @id @default(uuid())
  templeId        String
  temple          Temple            @relation(fields: [templeId], references: [id], onDelete: Cascade)

  messageType     LineMessageType
  targetMemberIds String[]

  content         Json

  sentCount       Int               @default(0)
  deliveredCount  Int               @default(0)
  openedCount     Int               @default(0)

  scheduledAt     DateTime?
  sentAt          DateTime?
  status          LineMessageStatus @default(DRAFT)

  createdBy       String?
  createdAt       DateTime          @default(now())

  @@index([templeId, createdAt(sort: Desc)])
  @@map("line_messages")
}

enum LineMessageType {
  BROADCAST  // 一斉配信
  INDIVIDUAL // 個別配信
  REMINDER   // リマインダー
  // @deprecated — 後方互換性のため残存。新規コードでは使用しないこと
  SEGMENT  // @deprecated
  STEP     // @deprecated
  THANKYOU // @deprecated

  @@map("line_message_type")
}

enum LineMessageStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED

  @@map("line_message_status")
}

// ==========================================
// 参拝記録（ジャーナリング）
// ==========================================
model TempleVisit {
  id        String      @id @default(uuid())
  memberId  String
  member    Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  templeId  String
  temple    Temple      @relation(fields: [templeId], references: [id], onDelete: Cascade)
  memo      String      @default("")
  source    VisitSource @default(SELF_REPORT)
  photoUrl  String?
  visitedAt DateTime    @default(now())

  @@index([memberId, visitedAt(sort: Desc)])
  @@map("temple_visits")
}

enum VisitSource {
  SELF_REPORT    // 参加者自己申告
  TEMPLE_RECORD  // お寺が記録
  EVENT_CHECKIN  // イベントチェックイン

  @@map("visit_source")
}

// ==========================================
// 機能利用ログ
// ==========================================
model FeatureLog {
  id       String @id @default(uuid())
  templeId String
  userId   String
  feature  String // "member_notes", "tag_filter", "dashboard_widget" など
  action   String // "create", "edit", "delete", "pin", "view", "click" など

  createdAt DateTime @default(now())

  @@index([templeId])
  @@index([feature])
  @@index([createdAt])
  @@map("feature_logs")
}

// ==========================================
// イベント写真
// ==========================================
model EventPhoto {
  id        String   @id @default(cuid())
  eventId   String
  memberId  String
  url       String
  caption   String?  @db.Text
  createdAt DateTime @default(now())

  event      Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedBy Member @relation(fields: [memberId], references: [id])

  @@index([eventId])
  @@index([memberId])
  @@map("event_photos")
}

// ==========================================
// イベント振り返り
// ==========================================
model EventReflection {
  id        String   @id @default(cuid())
  eventId   String
  memberId  String
  content   String   @db.Text
  createdAt DateTime @default(now())

  event  Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member                  @relation(fields: [memberId], references: [id])
  thanks EventReflectionThanks[]

  @@unique([eventId, memberId])
  @@index([eventId])
  @@map("event_reflections")
}

// ==========================================
// 振り返りへのありがとう
// ==========================================
model EventReflectionThanks {
  id           String   @id @default(cuid())
  reflectionId String
  memberId     String
  createdAt    DateTime @default(now())

  reflection EventReflection @relation(fields: [reflectionId], references: [id], onDelete: Cascade)
  member     Member          @relation(fields: [memberId], references: [id])

  @@unique([reflectionId, memberId])
  @@index([reflectionId])
  @@map("event_reflection_thanks")
}

// ==========================================
// お寺の声（TemplePost）
// ==========================================
model TemplePost {
  id          String   @id @default(cuid())
  templeId    String
  authorId    String
  title       String?
  body        String   @db.Text
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  temple  Temple           @relation(fields: [templeId], references: [id], onDelete: Cascade)
  author  User             @relation(fields: [authorId], references: [id])
  photos  TemplePostPhoto[]

  @@index([templeId, publishedAt(sort: Desc)])
  @@index([publishedAt(sort: Desc)])
  @@map("temple_posts")
}

model TemplePostPhoto {
  id        String   @id @default(cuid())
  postId    String
  url       String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  post TemplePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("temple_post_photos")
}

// ==========================================
// 学びの記事
// ==========================================
enum ArticleCategory {
  PARTICIPATION  // 参拝の作法
  DENOMINATION   // 宗派について
  CEREMONY       // 行事・節句
  PRACTICE       // 坐禅・写経等の実践
  OTHER

  @@map("article_category")
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("article_status")
}

model Article {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  excerpt     String          @db.Text
  body        String          @db.Text
  category    ArticleCategory
  status      ArticleStatus   @default(DRAFT)
  authorId    String
  templeId    String?
  coverImage  String?
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  author User    @relation("ArticleAuthor", fields: [authorId], references: [id])
  temple Temple? @relation(fields: [templeId], references: [id])

  @@index([status, publishedAt(sort: Desc)])
  @@index([category, status])
  @@index([slug])
  @@map("articles")
}

// ==========================================
// 学びの日記（Journal） — 完全プライベート
// ==========================================
enum Mood {
  PEACEFUL    // 穏やか
  GRATEFUL    // 感謝
  STRUGGLING  // 葛藤
  REFLECTIVE  // 内省
  JOYFUL      // 喜び

  @@map("mood")
}

model Journal {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String?  @db.VarChar(100)
  content String   @db.Text
  mood    Mood?
  tags    String[]

  entryDate DateTime

  relatedEventId String?
  relatedEvent   Event?  @relation(fields: [relatedEventId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, entryDate(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("journals")
}
