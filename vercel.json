{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "regions": ["hnd1"],
  "crons": [
    {
      "path": "/api/cron/reminders?type=evening",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/reminders?type=morning",
      "schedule": "0 0 * * *"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "rewrites": [],
  "redirects": [
    {
      "source": "/login",
      "destination": "/auth/login",
      "permanent": true
    },
    {
      "source": "/register",
      "destination": "/auth/register",
      "permanent": true
    }
  ]
}
